{
  "expo": {
    "name": "Lomas Eveneser",
    "slug": "lomas-frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lomaseveneser.app"
    },
    "android": {
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-secure-store"
    ],
    "icon": "./assets/lomas-logo.png"
  }
}
